<?xml version="1.0"?>
<sdf version="1.6">
  <model name="boe_robot">
    <static>false</static>
    <self_collide>false</self_collide>
    <!-- Cho Gazebo đưa robot về trạng thái ngủ khi đã đứng yên. -->
    <allow_auto_disable>true</allow_auto_disable>

    <!--
      Gazebo gộp các chi tiết nối cố định vào base_link để tránh hệ ràng buộc
      thừa làm ODE sinh NaN. URDF/RViz vẫn giữ đầy đủ các link và TF riêng.
    -->
    <link name="base_link">
      <pose>-0.0319316266 0.0042939669 0.03215 0 0 0</pose>
      <inertial>
        <pose>0 0 0.018 0 0 0</pose>
        <mass>0.25</mass>
        <inertia>
          <ixx>3.93e-04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17e-04</iyy>
          <iyz>0</iyz>
          <izz>5.75e-04</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>-0.0018954 -0.0042940 0.0018238 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1209 0.1150 0.0335</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.796 0.824 0.937 1</ambient>
          <diffuse>0.796 0.824 0.937 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_collision">
        <pose>-0.0026153108 -0.0043260086 0.0390737661 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.041</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <pose>-0.0070723108 -0.0045653019 0.0434219487 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/lidar_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="caster_base_collision">
        <pose>-0.0411669073 -0.0042939669 0.0126581966 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02925 0.04230 0.00883</size>
          </box>
        </geometry>
      </collision>
      <visual name="caster_base_visual">
        <pose>-0.0049954073 -0.0042939669 0.0185737626 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/caster_base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.796 0.824 0.937 1</ambient>
          <diffuse>0.796 0.824 0.937 1</diffuse>
        </material>
      </visual>
      <!-- Điểm tỳ vật lý; hai link caster bên dưới chỉ để hiển thị. -->
      <collision name="caster_support_collision">
        <pose>-0.0231868044 -0.0003851059 -0.0141 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.01805</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.02</mu>
              <mu2>0.02</mu2>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <!-- Bánh trái: tâm tuyệt đối (0.001, 0.0575, 0.032724). -->
    <link name="wheel_left_link">
      <pose>0.001 0.0575 0.0327237626 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>8.27e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.61e-05</iyy>
          <iyz>0</iyz>
          <izz>8.27e-06</izz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <pose>0 0.002125 0 1.5707963268 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03272</radius>
            <length>0.00975</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Bám theo hướng lăn X, cho phép trượt ngang khi quay vi sai. -->
              <mu>1.0</mu>
              <mu2>0.8</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <pose>0 0 0 1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/wheel_left_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>1.0</effort>
          <velocity>20.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Bánh phải: tâm tuyệt đối (-0.001, -0.0575, 0.032724). -->
    <link name="wheel_right_link">
      <pose>-0.001 -0.0575 0.0327237626 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>8.27e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.61e-05</iyy>
          <iyz>0</iyz>
          <izz>8.27e-06</izz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <pose>0 -0.002125 0 -1.5707963268 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03272</radius>
            <length>0.00975</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Hai bánh dùng cùng quy ước trục X là hướng lăn. -->
              <mu>1.0</mu>
              <mu2>0.8</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.0005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <pose>0 0 0 -1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/wheel_right_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>1.0</effort>
          <velocity>20.0</velocity>
        </limit>
      </axis>
    </joint>

    <!--
      Plugin dẫn động vi sai:
      nhận geometry_msgs/Twist trên /cmd_vel và điều khiển hai bánh chủ động.
    -->
    <plugin name="boe_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>

      <!-- Hai joint chủ động. -->
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>

      <!-- Thông số động học của robot. -->
      <wheel_separation>0.115</wheel_separation>
      <wheel_diameter>0.06544</wheel_diameter>

      <!-- Giới hạn mô-men và gia tốc bánh. -->
      <!--
        Robot chỉ nặng khoảng 0.31 kg. Mô-men quá lớn làm bánh trượt
        và khiến ODE sinh chuyển động sai khi đổi hướng.
      -->
      <max_wheel_torque>0.10</max_wheel_torque>
      <!--
        Giá trị 0 khiến plugin đặt trực tiếp vận tốc đích của hai bánh.
        Tránh bộ cộng dồn gia tốc của gazebo_ros_diff_drive làm lệnh
        trước ảnh hưởng lệnh sau trên robot có khối lượng nhỏ.
      -->
      <max_wheel_acceleration>0.0</max_wheel_acceleration>

      <!-- Topic lệnh vận tốc. -->
      <command_topic>cmd_vel</command_topic>

      <!-- Odometry và TF. -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <!-- Xuất góc joint thật từ Gazebo lên /joint_states. -->
    <plugin
      name="boe_joint_state_publisher"
      filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
