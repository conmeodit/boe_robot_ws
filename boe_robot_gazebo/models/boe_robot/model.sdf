<?xml version="1.0"?>
<sdf version="1.6">
  <model name="boe_robot">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!--
      Gazebo gộp các chi tiết nối cố định vào base_link để tránh hệ ràng buộc
      thừa làm ODE sinh NaN. URDF/RViz vẫn giữ đầy đủ các link và TF riêng.
    -->
    <link name="base_link">
      <pose>-0.0319316266 0.0042939669 0.03215 0 0 0</pose>
      <inertial>
        <pose>0 0 0.018 0 0 0</pose>
        <mass>0.25</mass>
        <inertia>
          <ixx>3.93e-04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17e-04</iyy>
          <iyz>0</iyz>
          <izz>5.75e-04</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>-0.0018954 -0.0042940 0.0018238 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1209 0.1150 0.0335</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.796 0.824 0.937 1</ambient>
          <diffuse>0.796 0.824 0.937 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_collision">
        <pose>-0.0026153108 -0.0043260086 0.0390737661 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.041</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <pose>-0.0070723108 -0.0045653019 0.0434219487 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/lidar_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="caster_base_collision">
        <pose>-0.0411669073 -0.0042939669 0.0126581966 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02925 0.04230 0.00883</size>
          </box>
        </geometry>
      </collision>
      <visual name="caster_base_visual">
        <pose>-0.0049954073 -0.0042939669 0.0185737626 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/caster_base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.796 0.824 0.937 1</ambient>
          <diffuse>0.796 0.824 0.937 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Bánh trái: tâm tuyệt đối (0.001, 0.0575, 0.032724). -->
    <link name="wheel_left_link">
      <pose>0.001 0.0575 0.0327237626 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>8.27e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.61e-05</iyy>
          <iyz>0</iyz>
          <izz>8.27e-06</izz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <pose>0 0.002125 0 1.5707963268 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03272</radius>
            <length>0.00975</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <pose>0 0 0 1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/wheel_left_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>1.0</effort>
          <velocity>20.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- Bánh phải: tâm tuyệt đối (-0.001, -0.0575, 0.032724). -->
    <link name="wheel_right_link">
      <pose>-0.001 -0.0575 0.0327237626 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>8.27e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.61e-05</iyy>
          <iyz>0</iyz>
          <izz>8.27e-06</izz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <pose>0 -0.002125 0 -1.5707963268 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03272</radius>
            <length>0.00975</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <pose>0 0 0 -1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/wheel_right_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>1.0</effort>
          <velocity>20.0</velocity>
        </limit>
      </axis>
    </joint>

    <link name="caster_rotation_link">
      <pose>-0.0730984469 0 0.0400696660 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>4.0e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0e-06</iyy>
          <iyz>0</iyz>
          <izz>4.0e-06</izz>
        </inertia>
      </inertial>
      <collision name="caster_rotation_collision">
        <pose>0.0075675 0.0003090 -0.0147200 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04273 0.02820 0.03036</size>
          </box>
        </geometry>
      </collision>
      <visual name="caster_rotation_visual">
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/caster_rotation_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.796 0.824 0.937 1</ambient>
          <diffuse>0.796 0.824 0.937 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="caster_rotation_joint" type="revolute">
      <parent>base_link</parent>
      <child>caster_rotation_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.02</damping>
          <friction>0</friction>
        </dynamics>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>0.5</effort>
          <velocity>10.0</velocity>
        </limit>
      </axis>
    </joint>

    <link name="caster_wheel_link">
      <pose>-0.0551184310 0.0039088610 0.0170696660 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>2.39e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.26e-06</iyy>
          <iyz>0</iyz>
          <izz>2.39e-06</izz>
        </inertia>
      </inertial>
      <collision name="caster_wheel_collision">
        <pose>0 0 0 -1.5707963268 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.01805</radius>
            <length>0.02135</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!--
                Bánh caster được khóa với càng để tránh ODE sinh NaN.
                Ma sát nhỏ giúp caster vẫn trượt thụ động khi xe chạy.
              -->
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_wheel_visual">
        <pose>0 0 0 -1.5707963268 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://boe_robot_description/meshes/caster_wheel_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!--
      Khóa bánh với càng ở mô phỏng cơ bản. Khớp đổi hướng phía trên
      vẫn là revolute nên cả cụm caster có thể tự xoay theo hướng chuyển động.
    -->
    <joint name="caster_wheel_joint" type="fixed">
      <parent>caster_rotation_link</parent>
      <child>caster_wheel_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
        </dynamics>
        <limit>
          <lower>-1000000</lower>
          <upper>1000000</upper>
          <effort>0.5</effort>
          <velocity>20.0</velocity>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
