<?xml version="1.0"?>
<sdf version="1.6">
  <world name="boe_turtlebot3_world">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>30.0</update_rate>
    </plugin>

    <!-- Đồng bộ hai mesh caster trực quan theo chuyển động của base_link. -->
    <plugin
      name="boe_caster_visual_plugin"
      filename="libboe_caster_visual_plugin.so"/>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Giữ nguyên sân, tường bao và chín cột của turtlebot3_world. -->
    <model name="turtlebot3_world">
      <static>true</static>
      <include>
        <uri>model://turtlebot3_world</uri>
      </include>
    </model>

    <!--
      Hai model dưới đây chỉ dùng để hiển thị caster quay và lăn.
      Điểm tỳ vật lý của caster vẫn nằm trong model.sdf của BOE.
    -->
    <model name="boe_caster_rotation_visual">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://boe_robot_description/meshes/caster_rotation_link.STL</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.796 0.824 0.937 1</ambient>
            <diffuse>0.796 0.824 0.937 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boe_caster_wheel_visual">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0 -1.5707963268 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://boe_robot_description/meshes/caster_wheel_link.STL</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose frame="">0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.0</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
  </world>
</sdf>
