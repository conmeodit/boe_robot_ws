<?xml version="1.0"?>
<sdf version="1.6">
  <world name="boe_lidar_test_world">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>30.0</update_rate>
    </plugin>

    <plugin
      name="boe_caster_visual_plugin"
      filename="libboe_caster_visual_plugin.so"/>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="boe_caster_rotation_visual">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://boe_robot_description/meshes/caster_rotation_link.STL</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.796 0.824 0.937 1</ambient>
            <diffuse>0.796 0.824 0.937 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boe_caster_wheel_visual">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0 -1.5707963268 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://boe_robot_description/meshes/caster_wheel_link.STL</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tường phía trước robot. -->
    <model name="front_wall">
      <static>true</static>
      <pose>1.0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 1.60 0.50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 1.60 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.32 0.20 1</ambient>
            <diffuse>0.80 0.32 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tường bên trái tạo góc vuông để quan sát hình dạng scan. -->
    <model name="left_wall">
      <static>true</static>
      <pose>0 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.10 0.10 0.50</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.10 0.10 0.50</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.48 0.82 1</ambient>
            <diffuse>0.20 0.48 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hộp nhỏ phía trước bên phải. -->
    <model name="test_box">
      <static>true</static>
      <pose>0.55 -0.45 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.30 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.20 0.72 0.36 1</ambient>
            <diffuse>0.20 0.72 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trụ tròn phía sau bên trái. -->
    <model name="test_cylinder">
      <static>true</static>
      <pose>-0.65 0.38 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.18</radius>
              <length>0.40</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.78 0.68 0.16 1</ambient>
            <diffuse>0.78 0.68 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.81</gravity>

    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <ode>
        <solver>
          <type>world</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.8 -1.8 1.20 0 0.45 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
