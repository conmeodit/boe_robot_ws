<?xml version="1.0"?>
<sdf version="1.6">
  <world name="boe_empty_world">

    <!-- Xuất pose thực của model và từng link để kiểm tra mô phỏng. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>30.0</update_rate>
    </plugin>

    <!-- Cập nhật hai mesh caster trực tiếp theo từng bước mô phỏng. -->
    <plugin
      name="boe_caster_visual_plugin"
      filename="libboe_caster_visual_plugin.so"/>

    <!-- Mặt đất -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Ánh sáng mặt trời -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Hai model chỉ chứa mesh để nhìn thấy caster đổi hướng và lăn.
      Chúng không có collision nên không tác động ngược vào robot vật lý.
      Node caster_visual_controller cho chúng bám theo base_link.
    -->
    <model name="boe_caster_rotation_visual">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://boe_robot_description/meshes/caster_rotation_link.STL</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.796 0.824 0.937 1</ambient>
            <diffuse>0.796 0.824 0.937 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="boe_caster_wheel_visual">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0 -1.5707963268 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://boe_robot_description/meshes/caster_wheel_link.STL</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trọng lực -->
    <gravity>0 0 -9.81</gravity>

    <!-- Cấu hình bộ mô phỏng vật lý ODE -->
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <ode>
        <solver>
          <!-- Solver trực tiếp ổn định hơn cho robot nhỏ có ba điểm tỳ. -->
          <type>world</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Góc nhìn mặc định -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.6 -0.6 0.45 0 0.45 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
